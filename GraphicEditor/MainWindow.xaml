<Window x:Class="GraphicEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор"
        Width="1260" Height="780"
        MinWidth="1100" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ToolRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ToolBorder"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToolBorder" Property="Background" Value="#E9F0FF" />
                                <Setter TargetName="ToolBorder" Property="BorderBrush" Value="#3B70D4" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolBorder" Property="BorderBrush" Value="#3B70D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToolbarComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="38" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#17243D" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Графический редактор"
                               FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Рисуйте линии и фигуры. Сохраните результат в PNG."
                               FontSize="12" Foreground="#AABBD5" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Очистить холст"
                            Click="ClearButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Background="#30405C" Foreground="White" BorderBrush="#54637A"
                            Margin="0,0,10,0" />
                    <Button Content="Сохранить PNG"
                            Click="SaveButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Background="#437CF5" Foreground="White" BorderBrush="#437CF5" />
                </StackPanel>
            </Grid>
        </Border>

        
        <Border Grid.Row="1" Background="White"
                BorderBrush="#DCE4EE" BorderThickness="0,0,0,1"
                Padding="22,13">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Инструменты"
                           Foreground="#64748B" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <RadioButton Content="Карандаш" Tag="Pencil"
                             GroupName="DrawingTools" IsChecked="True"
                             Checked="ToolRadio_Checked"
                             Style="{StaticResource ToolRadioStyle}" />
                <RadioButton Content="Линия" Tag="Line"
                             GroupName="DrawingTools"
                             Checked="ToolRadio_Checked"
                             Style="{StaticResource ToolRadioStyle}" />
                <RadioButton Content="Прямоугольник" Tag="Rectangle"
                             GroupName="DrawingTools"
                             Checked="ToolRadio_Checked"
                             Style="{StaticResource ToolRadioStyle}" />
                <RadioButton Content="Эллипс" Tag="Ellipse"
                             GroupName="DrawingTools"
                             Checked="ToolRadio_Checked"
                             Style="{StaticResource ToolRadioStyle}" />

                <Border Width="1" Height="30" Background="#CBD5E1" Margin="8,0,17,0" />

                <TextBlock Text="Цвет"
                           Foreground="#64748B" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,9,0" />

                <Border x:Name="ColorPreviewBorder"
                        Width="26" Height="26" CornerRadius="7"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        Background="#1F2937" VerticalAlignment="Center" Margin="0,0,8,0" />

                <ComboBox x:Name="ColorComboBox"
                          Style="{StaticResource ToolbarComboStyle}"
                          Width="112" SelectedIndex="0"
                          SelectionChanged="ColorComboBox_SelectionChanged"
                          Margin="0,0,9,0">
                    <ComboBoxItem Content="Графит" Tag="#1F2937" />
                    <ComboBoxItem Content="Синий" Tag="#2563EB" />
                    <ComboBoxItem Content="Красный" Tag="#DC2626" />
                    <ComboBoxItem Content="Зелёный" Tag="#16A34A" />
                    <ComboBoxItem Content="Фиолетовый" Tag="#9333EA" />
                    <ComboBoxItem Content="Оранжевый" Tag="#EA580C" />
                    <ComboBoxItem Content="Розовый" Tag="#DB2777" />
                    <ComboBoxItem Content="Бирюзовый" Tag="#0891B2" />
                    <ComboBoxItem Content="Чёрный" Tag="#000000" />
                </ComboBox>

                <TextBox x:Name="HexColorTextBox"
                         Width="85" Height="38" FontSize="12"
                         Text="#1F2937"
                         VerticalContentAlignment="Center"
                         Padding="6,0" Margin="0,0,5,0"
                         ToolTip="Укажите любой цвет в формате #RRGGBB" />
                <Button Content="OK"
                        Click="ApplyColorButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="#E9EFFA" Foreground="#1F3B65"
                        BorderBrush="#CBD5E1" Margin="0,0,15,0" />

                <TextBlock Text="Толщина"
                           Foreground="#64748B" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox x:Name="ThicknessComboBox"
                          Style="{StaticResource ToolbarComboStyle}"
                          Width="72" SelectedIndex="2"
                          SelectionChanged="ThicknessComboBox_SelectionChanged">
                    <ComboBoxItem Content="1 px" Tag="1" />
                    <ComboBoxItem Content="2 px" Tag="2" />
                    <ComboBoxItem Content="3 px" Tag="3" />
                    <ComboBoxItem Content="5 px" Tag="5" />
                    <ComboBoxItem Content="8 px" Tag="8" />
                    <ComboBoxItem Content="12 px" Tag="12" />
                    <ComboBoxItem Content="20 px" Tag="20" />
                </ComboBox>
            </StackPanel>
        </Border>

       
        <Border Grid.Row="2" Margin="24,20,24,14"
                Background="White" BorderBrush="#D4DEEA"
                BorderThickness="1" CornerRadius="5">
            <Border.Effect>
                <DropShadowEffect Color="#73839D" BlurRadius="17" ShadowDepth="2" Opacity="0.15" />
            </Border.Effect>
            <Canvas x:Name="DrawingCanvas"
                    Background="White" ClipToBounds="True"
                    Cursor="Cross"
                    MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                    MouseMove="DrawingCanvas_MouseMove"
                    MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                    LostMouseCapture="DrawingCanvas_LostMouseCapture" />
        </Border>

        
        <Border Grid.Row="3" Background="#E8EDF5"
                BorderBrush="#D4DEEA" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock" Grid.Column="0"
                           Text="Выберите инструмент и рисуйте с зажатой левой кнопкой мыши."
                           Foreground="#475569" FontSize="12" />
                <TextBlock x:Name="PositionTextBlock" Grid.Column="1"
                           Text="X: 0   Y: 0" Foreground="#64748B"
                           FontSize="12" Margin="20,0" />
                <TextBlock x:Name="ObjectCountTextBlock" Grid.Column="2"
                           Text="Объектов: 0" Foreground="#334155"
                           FontWeight="SemiBold" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
